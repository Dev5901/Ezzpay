<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/appBg">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/add_wallet_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/add_wallet"
        android:visibility="gone"
        android:layout_centerInParent="true"
        android:textSize="18sp"
        android:layout_marginBottom="10dp"
        android:drawableLeft="@drawable/round_add_24"
        android:drawablePadding="20dp"
        android:textColor="@color/offWhite"
        android:fontFamily="sans-serif-black"
        android:background="@color/cardRed" />

    <androidx.cardview.widget.CardView
        android:id="@+id/card_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="18dp"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="30dp"
        app:cardElevation="20dp"
        app:cardBackgroundColor="@color/cardRed">

        <LinearLayout
            android:layout_width="375dp"
            android:layout_height="250dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingTop="30dp"
            android:paddingBottom="30dp">

            <TextView
                android:id="@+id/username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="Full Name"
                android:textColor="@color/offWhite"
                android:textSize="30sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/wallet_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wallet ID"
                android:textColor="@color/offWhite"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="5dp"/>

            <TextView
                android:id="@+id/wallet_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Balance"
                android:textColor="@color/offWhite"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="60dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/send_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="16dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/offWhite"
                    android:fontFamily="sans-serif-black"
                    android:padding="12dp"
                    android:text="Send"
                    android:textColor="@color/darkGrey"
                    android:textSize="16dp"
                    app:cornerRadius="20dp" />

                <Button
                    android:id="@+id/receive_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:backgroundTint="@color/offWhite"
                    android:fontFamily="sans-serif-black"
                    android:padding="12dp"
                    android:text="Receive"
                    android:textColor="@color/darkGrey"
                    android:textSize="16dp"
                    app:cornerRadius="20dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/bottom_buttons_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:background="@color/cardRed"
        android:padding="1dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/profile_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/offWhite"
            android:fontFamily="sans-serif-black"
            android:padding="12dp"
            android:text="Profile"
            android:textColor="@color/darkGrey"
            android:textSize="13sp"
            app:icon="@drawable/round_account_circle_24"
            app:iconGravity="start"
            app:iconPadding="8dp"
            app:cornerRadius="20dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/history_button"
            android:layout_width="0dp"
            android:layout_height="57dp"
            android:layout_weight="1"
            android:backgroundTint="@color/offWhite"
            android:fontFamily="sans-serif-black"
            android:padding="1dp"
            android:text="History"
            android:textColor="@color/darkGrey"
            android:textSize="13sp"
            app:cornerRadius="20dp"
            app:icon="@drawable/round_history_arrows_24"
            app:iconGravity="start"
            app:iconPadding="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sign_out_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/offWhite"
            android:fontFamily="sans-serif-black"
            android:padding="12dp"
            android:text="Sign Out"
            android:textColor="@color/darkGrey"
            android:textSize="13sp"
            app:icon="@drawable/baseline_exit_to_app_24"
            app:iconGravity="start"
            app:iconPadding="8dp"
            app:cornerRadius="20dp" />
    </LinearLayout>



</RelativeLayout>
