<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background color -->
    <solid android:color="@color/offWhite" />

    <!-- Set rounded corners -->
    <corners android:radius="20dp" />

    <!-- Optional padding to create space inside the button -->
    <padding
        android:left="16dp"
        android:top="8dp"
        android:right="16dp"
        android:bottom="8dp" />
</shape>
